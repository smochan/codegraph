# LLM API keys for the bench/ harness (plain-LLM control runner).
# Populated automatically by `seedenv .` from ~/.config/secrets/keys.env.
# Only the provider currently selected via BENCH_LLM_PROVIDER is required.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: pin the bench's LLM provider + model.
# BENCH_LLM_PROVIDER=gemini
# BENCH_LLM_MODEL=gemini-2.5-flash
